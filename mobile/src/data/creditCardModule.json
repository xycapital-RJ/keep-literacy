{
  "module_id": "credit_card",
  "module_title": "Credit Card Masterclass",
  "slides": [
    {
      "slide_number": 1,
      "slide_id": "cc-s1a-script",
      "description": "Screen 1A — The Script",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24px; text-align:center; padding:0 10px; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes assemble1 { 0% { transform:translate(-56px,-28px) rotate(-25deg); opacity:0;} 100% { transform:translate(0,0) rotate(0deg); opacity:1;} }\n@keyframes assemble2 { 0% { transform:translate(56px,-20px) rotate(20deg); opacity:0;} 100% { transform:translate(0,0) rotate(0deg); opacity:1;} }\n@keyframes assemble3 { 0% { transform:translate(-40px,36px) rotate(15deg); opacity:0;} 100% { transform:translate(0,0) rotate(0deg); opacity:1;} }\n@keyframes assemble4 { 0% { transform:translate(48px,32px) rotate(-18deg); opacity:0;} 100% { transform:translate(0,0) rotate(0deg); opacity:1;} }\n.pc1 { animation: assemble1 0.6s cubic-bezier(.22,1,.36,1) .1s both; }\n.pc2 { animation: assemble2 0.6s cubic-bezier(.22,1,.36,1) .18s both; }\n.pc3 { animation: assemble3 0.6s cubic-bezier(.22,1,.36,1) .26s both; }\n.pc4 { animation: assemble4 0.6s cubic-bezier(.22,1,.36,1) .34s both; }\n.f1 { animation: drift .5s ease .55s both; }\n.f2 { animation: drift .5s ease .85s both; }\n\n.pieces { position:relative; width:90px; height:60px; }\n.piece { position:absolute; width:44px; height:28px; background:var(--surface-1); border:1.5px solid var(--border-strong); border-radius:5px; }\n.quote { font-size:15px; color:var(--text-secondary); font-style:italic; margin:0; max-width:260px; line-height:1.55; }\n.main { font-family: var(--font-voice); font-size:24px; line-height:1.5; margin:0; max-width:100%; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <div class=\"pieces\">\n      <div class=\"piece pc1\" style=\"top:0;left:0;\"></div>\n      <div class=\"piece pc2\" style=\"top:0;right:0;\"></div>\n      <div class=\"piece pc3\" style=\"bottom:0;left:0;\"></div>\n      <div class=\"piece pc4\" style=\"bottom:0;right:0;\"></div>\n    </div>\n    <p class=\"f1 quote\">\"Credit cards are evil. They'll ruin your life. Stick to debit.\"</p>\n    <p class=\"f2 main\">It sounds like safe advice. It's actually a financial trap.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 2,
      "slide_id": "cc-s1b-ad-crack",
      "description": "Screen 1B — The Ad Cracks Open",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; justify-content:center; gap:18px; padding:0 6px; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes crackReveal { 0% { clip-path: inset(0 0 100% 0);} 100% { clip-path: inset(0 0 0 0);} }\n.f1 { animation: drift .5s ease .1s both; }\n.f2 { animation: drift .5s ease .6s both; }\n.fine { animation: crackReveal .7s cubic-bezier(.22,1,.36,1) .6s both; }\n\n.badge { font-size:12px; font-weight:600; padding:6px 10px; border-radius:8px; }\n.ad-card { background:var(--surface-1); border-radius:16px; padding:20px; display:flex; flex-direction:column; gap:12px; }\n.fine-box { background:var(--surface-2); border:1px dashed var(--border-strong); border-radius:12px; padding:14px 16px; margin-top:6px; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <p class=\"f1\" style=\"font-size:17px; margin:0;\">You've seen the ads: cashback, airport lounges, 5X reward points.</p>\n    <div class=\"f1 ad-card\">\n      <div style=\"display:flex; gap:8px; flex-wrap:wrap;\">\n        <span class=\"badge\" style=\"background:var(--bg-warning); color:var(--text-warning);\">5X POINTS</span>\n        <span class=\"badge\" style=\"background:var(--bg-accent); color:var(--text-accent);\">LOUNGE ACCESS</span>\n        <span class=\"badge\" style=\"background:var(--bg-success); color:var(--text-success);\">CASHBACK</span>\n      </div>\n      <i class=\"ti ti-credit-card\" style=\"font-size:38px; color:var(--text-primary);\"></i>\n    </div>\n    <div class=\"fine fine-box\">\n      <p style=\"font-size:13.5px; color:var(--text-secondary); margin:0; line-height:1.6;\">What nobody shows you in that ad: the exact math of how a card can quietly cost <em>you</em> money instead.</p>\n    </div>\n    <p class=\"f2\" style=\"font-size:15px; margin:0; line-height:1.55;\">We'll get to the rewards. First — the thing that decides whether you're even allowed to play that game.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 3,
      "slide_id": "cc-s2-ghost",
      "description": "Screen 2 — Ghost Protocol",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes fadeGhost { 0% { opacity:1;} 100% { opacity:.3;} }\n.g-icon { animation: fadeGhost 2.2s ease-in-out .3s infinite alternate; font-size:48px; color:var(--text-secondary); }\n.seq1 { animation: drift .5s ease .1s both; }\n.seq2 { animation: drift .5s ease .4s both; }\n.seq3 { animation: drift .5s ease .7s both; }\n.seq4 { animation: drift .5s ease 1.0s both; }\n.age-badge { text-align:center; background:var(--surface-1); border-radius:10px; padding:10px 14px; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <i class=\"ti ti-user g-icon\"></i>\n    <p class=\"seq1\" style=\"font-size:17px; font-weight:500; margin:0; max-width:100%; line-height:1.5;\">If you only use cash and debit cards, you're financially invisible.</p>\n    <p class=\"seq2\" style=\"font-size:14.5px; color:var(--text-secondary); margin:0; max-width:100%; line-height:1.55;\">To a bank, a 28-year-old with zero credit history reads exactly as risky as an 18-year-old.</p>\n    <div class=\"seq3\" style=\"display:flex; align-items:center; gap:10px;\">\n      <div class=\"age-badge\"><p style=\"font-size:11px;color:var(--text-muted);margin:0;\">age 18</p></div>\n      <i class=\"ti ti-equal\" style=\"font-size:16px; color:var(--text-muted);\"></i>\n      <div class=\"age-badge\"><p style=\"font-size:11px;color:var(--text-muted);margin:0;\">age 28</p></div>\n    </div>\n    <p class=\"seq4\" style=\"font-size:16px; font-weight:600; margin:0;\">You are a ghost.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 4,
      "slide_id": "cc-s3-trust",
      "description": "Screen 3 — The Trust Test",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes turnKey { 0% { transform:rotate(-25deg);} 60% { transform:rotate(15deg);} 100% { transform:rotate(0deg);} }\n@keyframes doorOpen { 0% { transform:perspective(220px) rotateY(0deg);} 100% { transform:perspective(220px) rotateY(-16deg);} }\n.k-key { animation: turnKey .8s ease .5s both; transform-origin:70% 50%; display:inline-block; font-size:30px; color:var(--text-accent); position:absolute; left:20px; top:44px; }\n.k-door { animation: doorOpen .8s ease .8s both; transform-origin:left center; width:64px; height:96px; background:var(--surface-1); border:1.5px solid var(--border-strong); border-radius:5px; position:absolute; right:20px; }\n.seq1 { animation: drift .5s ease .1s both; }\n.seq2 { animation: drift .5s ease 1.3s both; }\n.door-wrap { position:relative; width:150px; height:110px; display:flex; align-items:center; justify-content:center; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <p class=\"seq1\" style=\"font-size:17px; font-weight:500; margin:0; max-width:260px; line-height:1.5;\">A credit card isn't extra money. It's a trust test.</p>\n    <div class=\"door-wrap\">\n      <div class=\"k-door\"></div>\n      <i class=\"ti ti-key k-key\"></i>\n    </div>\n    <p class=\"seq2\" style=\"font-size:14px; color:var(--text-secondary); margin:0; max-width:260px; line-height:1.6;\">Banks watch how you handle a small amount of borrowed money before they'll ever trust you with a big one — a car loan, a home loan.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 5,
      "slide_id": "cc-s4-debit-math",
      "description": "Screen 4 — The Debit Math",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes coinFly1 { 0% { transform:translate(0,0); opacity:1;} 100% { transform:translate(-38px,-48px); opacity:0;} }\n@keyframes coinFly2 { 0% { transform:translate(0,0); opacity:1;} 100% { transform:translate(10px,-58px); opacity:0;} }\n@keyframes coinFly3 { 0% { transform:translate(0,0); opacity:1;} 100% { transform:translate(40px,-42px); opacity:0;} }\n.coin1 { animation: coinFly1 1s ease-out .4s infinite; }\n.coin2 { animation: coinFly2 1s ease-out .65s infinite; }\n.coin3 { animation: coinFly3 1s ease-out .9s infinite; }\n.seq1 { animation: drift .5s ease .1s both; }\n.seq2 { animation: drift .5s ease 1.2s both; }\n.vault-wrap { position:relative; width:100px; height:100px; display:flex; align-items:center; justify-content:center; }\n.coin { position:absolute; font-size:18px; color:var(--text-warning); }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <p class=\"seq1\" style=\"font-size:17px; font-weight:500; margin:0; max-width:260px; line-height:1.5;\">Swipe a debit card, and the money leaves your bank instantly.</p>\n    <div class=\"vault-wrap\">\n      <i class=\"ti ti-building-bank\" style=\"font-size:46px; color:var(--text-secondary);\"></i>\n      <i class=\"ti ti-coin coin coin1\"></i>\n      <i class=\"ti ti-coin coin coin2\"></i>\n      <i class=\"ti ti-coin coin coin3\"></i>\n    </div>\n    <p class=\"seq2\" style=\"font-size:14px; color:var(--text-secondary); margin:0; max-width:260px; line-height:1.6;\">If someone steals your debit card info, they steal your actual cash — you have to fight the bank to get it back.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 6,
      "slide_id": "cc-s5-shield",
      "description": "Screen 5 — The Shield",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes arrowFly { 0% { transform:translateX(-90px); opacity:0;} 55% { opacity:1;} 70% { transform:translateX(8px);} 100% { transform:translateX(-6px); opacity:1;} }\n@keyframes shieldFlash { 0%, 60% { filter:drop-shadow(0 0 0 transparent);} 68% { filter:drop-shadow(0 0 8px var(--text-accent));} 100% { filter:drop-shadow(0 0 0 transparent);} }\n.arrow { animation: arrowFly 1.6s cubic-bezier(.3,.7,.4,1) .3s infinite; font-size:26px; color:var(--text-danger); position:absolute; left:0; }\n.shield { animation: shieldFlash 1.6s ease .3s infinite; font-size:48px; color:var(--text-accent); position:absolute; right:18px; }\n.seq1 { animation: drift .5s ease .1s both; }\n.seq2 { animation: drift .5s ease 1.1s both; }\n.shield-wrap { position:relative; width:110px; height:90px; display:flex; align-items:center; justify-content:center; overflow:hidden; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <p class=\"seq1\" style=\"font-size:17px; font-weight:500; margin:0; max-width:260px; line-height:1.5;\">Swipe a credit card, and you're spending the bank's money.</p>\n    <div class=\"shield-wrap\">\n      <i class=\"ti ti-shield-check shield\"></i>\n      <i class=\"ti ti-arrow-narrow-right arrow\"></i>\n    </div>\n    <p class=\"seq2\" style=\"font-size:14px; color:var(--text-secondary); margin:0; max-width:260px; line-height:1.6;\">If fraud happens, the bank's money is stolen, not yours. They fight to fix it — your checking account stays untouched.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 7,
      "slide_id": "cc-s6-borrowed-time",
      "description": "Screen 6 — Borrowed Time",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes glowPulse { 0%, 100% { opacity:.55;} 50% { opacity:1;} }\n.glow-range { animation: glowPulse 1.8s ease-in-out infinite; position:absolute; inset:0; background:var(--bg-accent); }\n.seq1 { animation: drift .5s ease .1s both; }\n.seq2 { animation: drift .5s ease 1.1s both; }\n.range-wrap { width:180px; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <p class=\"seq1\" style=\"font-size:17px; font-weight:500; margin:0; max-width:260px; line-height:1.5;\">This isn't extra cash. It's a 45-day, interest-free loan — if you know the rules.</p>\n    <div class=\"range-wrap\">\n      <div style=\"display:flex; justify-content:space-between; font-size:11px; color:var(--text-muted); margin-bottom:8px;\"><span>swipe</span><span>due date</span></div>\n      <div style=\"position:relative; height:12px; background:var(--surface-1); border-radius:6px; overflow:hidden;\">\n        <div class=\"glow-range\"></div>\n      </div>\n      <p style=\"font-size:13px; color:var(--text-accent); font-weight:600; margin:8px 0 0;\">45 days</p>\n    </div>\n    <p class=\"seq2\" style=\"font-size:14px; color:var(--text-secondary); margin:0;\">That gap is breathing room, not a reward.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 8,
      "slide_id": "cc-s7-two-users",
      "description": "Screen 7 — Two Types of Users",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes drawShort { 0% { stroke-dashoffset:140;} 100% { stroke-dashoffset:0;} }\n@keyframes drawLoop { 0% { stroke-dashoffset:300;} 100% { stroke-dashoffset:0;} }\n.path-short { stroke-dasharray:140; animation: drawShort 1s ease .5s both; }\n.path-loop { stroke-dasharray:300; animation: drawLoop 1.6s ease .5s both; }\n.seq1 { animation: drift .5s ease .1s both; }\n.seq2 { animation: drift .5s ease .4s both; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <div style=\"display:flex; flex-direction:column; gap:18px; align-items:center;\">\n      <div style=\"display:flex; align-items:center; gap:14px;\">\n        <svg width=\"90\" height=\"28\" viewBox=\"0 0 90 28\"><path class=\"path-short\" d=\"M2 14 H88\" stroke=\"var(--text-success)\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n        <span style=\"font-size:13px; color:var(--text-success); font-weight:600;\">Transactor</span>\n      </div>\n      <div style=\"display:flex; align-items:center; gap:14px;\">\n        <svg width=\"90\" height=\"36\" viewBox=\"0 0 90 36\"><path class=\"path-loop\" d=\"M2 18 H50 A12 12 0 1 1 50 19 H88\" stroke=\"var(--text-danger)\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n        <span style=\"font-size:13px; color:var(--text-danger); font-weight:600;\">Revolver</span>\n      </div>\n    </div>\n    <p class=\"seq1\" style=\"font-size:16px; font-weight:500; margin:0; max-width:260px; line-height:1.5;\">Transactors pay their full bill every time — interest-free, always.</p>\n    <p class=\"seq2\" style=\"font-size:14px; color:var(--text-secondary); margin:0; max-width:260px; line-height:1.6;\">Revolvers carry a balance and quietly fund the bank's profit margin with their own stress.</p>\n  </div>\n</div>\n"
    },
    {
      "slide_number": 9,
      "slide_id": "cc-s8-goal",
      "description": "Screen 8 — The Goal",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n@keyframes unlock { 0%, 55% { transform:rotate(0deg);} 100% { transform:rotate(-28deg);} }\n.shackle { transform-origin:30% 100%; animation: unlock 1.4s ease .6s infinite alternate; }\n.seq1 { animation: drift .5s ease .1s both; }\n.seq2 { animation: drift .5s ease .4s both; }\n.seq3 { animation: drift .5s ease 1.3s both; }\nbutton.cta { width:100%; height:54px; border-radius:var(--radius); background:var(--fill-primary); color:var(--on-primary); border:none; font-size:16px; font-weight:500; cursor:pointer; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--fill-primary, #171717); color: #FFFFFF; padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <svg width=\"60\" height=\"66\" viewBox=\"0 0 50 56\">\n      <path class=\"shackle\" d=\"M14 24 V16 A11 11 0 0 1 36 16 V24\" stroke=\"var(--text-primary)\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n      <rect x=\"8\" y=\"24\" width=\"34\" height=\"26\" rx=\"5\" fill=\"var(--surface-1)\" stroke=\"var(--text-primary)\" stroke-width=\"2\"/>\n    </svg>\n    <p class=\"seq1\" style=\"font-size:17px; font-weight:500; margin:0; max-width:100%; line-height:1.5;\">By the end of this scroll, you'll know exactly how to be a Transactor.</p>\n    <p class=\"seq2\" style=\"font-size:14px; color:var(--text-secondary); margin:0; max-width:260px; line-height:1.55;\">Including the one number that decides whether you ever pay interest at all.</p>\n  </div>\n  <button class=\"seq3 cta\">Let's calculate yours</button>\n</div>\n"
    },
    {
      "slide_number": 10,
      "slide_id": "cc-quiz-1",
      "description": "MCQ: Transactor vs Revolver",
      "type": "QUIZ",
      "question": "What is the key difference between a Transactor and a Revolver?",
      "options": [
        "Transactors pay the full balance on time; Revolvers carry debt",
        "Revolvers get more rewards points",
        "Transactors pay high interest every month",
        "There is no difference"
      ],
      "correctOption": 0,
      "explanation": "Transactors use credit cards for rewards and security but pay off 100% of their bill before interest accrues. Revolvers carry a balance and pay heavy interest."
    },
    {
      "slide_number": 11,
      "slide_id": "cc-s9-pivot",
      "description": "Screen 9 — The Pivot",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--on-primary); opacity:.7; margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; text-align:center; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n.d1 { animation: drift .5s ease .1s both; }\n.d2 { animation: drift .5s ease .35s both; }\n.d3 { animation: drift .5s ease .6s both; }\nbutton.cta { width:100%; height:54px; border-radius:var(--radius); background:var(--on-primary); color:var(--fill-primary); border:none; font-size:16px; font-weight:600; cursor:pointer; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--fill-primary, #171717); color: #FFFFFF; padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <p class=\"d1\" style=\"font-size:26px; font-weight:500; line-height:1.4; margin:0; color:var(--on-primary); max-width:100%;\">Stop reading for a second.</p>\n    <p class=\"d2\" style=\"font-size:16px; color:var(--on-primary); opacity:.85; margin:0; max-width:260px; line-height:1.55;\">Let's find your number — even if you've never held a credit card in your life.</p>\n  </div>\n  <button class=\"d3 cta\">Let's find out</button>\n</div>\n"
    },
    {
      "slide_number": 12,
      "slide_id": "cc-s10-branch",
      "description": "Screen 10 — Branch Choice (Do you have a card?)",
      "html": "<style>\n* { box-sizing: border-box; }\n\n\n.statusbar { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); margin-bottom:10px; }\n.content { flex:1; display:flex; flex-direction:column; justify-content:center; gap:16px; }\n\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n.d1 { animation: drift .5s ease .1s both; }\n.d2 { animation: drift .5s ease .35s both; }\n.d3 { animation: drift .5s ease .6s both; }\n.d4 { animation: drift .5s ease .85s both; }\n.opt { width:100%; text-align:left; height:64px; border-radius:14px; background:var(--surface-1);  padding:0 16px; display:flex; align-items:center; gap:14px; cursor:pointer; font-size:15px; font-weight:500; color:var(--text-primary); font-family:var(--font-body); }\n.opt i { font-size:20px; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:22px; border-radius:20px; box-sizing:border-box;\">\n\n  \n  <div class=\"content\">\n    <p class=\"d1\" style=\"font-size:20px; font-weight:500; margin:0 0 6px;\">Do you already have a credit card?</p>\n    <button class=\"opt d2\"><i class=\"ti ti-credit-card\" style=\"color:var(--text-accent);\"></i>Yes, I have one</button>\n    <button class=\"opt d3\"><i class=\"ti ti-wallet\" style=\"color:var(--text-success);\"></i>No, but I have income or pocket money</button>\n    <button class=\"opt d4\"><i class=\"ti ti-hourglass-empty\" style=\"color:var(--text-muted);\"></i>No, and I don't have income right now</button>\n  </div>\n  <p style=\"font-size:12px; color:var(--text-muted); text-align:center; margin:12px 0 0;\">Whatever you pick, there's a real answer for you next</p>\n</div>\n"
    },
    {
      "slide_number": 13,
      "slide_id": "cc-s10a-no-income",
      "description": "Screen 10A — No Income Route",
      "html": "<style>\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n.n1 { animation: drift .5s ease .1s both; }\n.n2 { animation: drift .5s ease .4s both; }\n.n3 { animation: drift .5s ease .7s both; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; text-align:center; background:var(--surface-2, #FFFFFF); color:var(--text-primary, #171717); padding:28px 24px; box-sizing:border-box;\">\n  <div style=\"font-size:48px; margin-bottom:4px;\">😊</div>\n  <p class=\"n1\" style=\"font-size:20px; font-weight:700; margin:0; max-width:260px; line-height:1.4; color:var(--text-primary, #171717);\">\n    Totally fine — you don't need income to learn this.\n  </p>\n  <div class=\"n2\" style=\"background:var(--surface-1, #F5F5F3); border-radius:16px; padding:16px 20px; display:flex; align-items:center; gap:14px; text-align:left; border:1px solid var(--border, #E5E4DE); max-width:280px;\">\n    <span style=\"font-size:24px;\">💡</span>\n    <p style=\"font-size:13.5px; color:var(--text-secondary, #5F5E5A); margin:0; line-height:1.5;\">\n      We'll use a placeholder number to show how the math works — swap in your real numbers later.\n    </p>\n  </div>\n  <button class=\"n3 cta\" style=\"width:100%; max-width:280px; height:54px; border-radius:14px; background:var(--text-primary, #171717); color:#FFFFFF; border:none; font-size:15px; font-weight:700; cursor:pointer; margin-top:8px;\">\n    Show me with an example →\n  </button>\n</div>"
    },
