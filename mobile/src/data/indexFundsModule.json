    {
      "slide_number": 14,
      "slide_id": "idx-s13-timeline",
      "description": "Screen 13 — Timeline Dial",
      "html": "<style>\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n.s1 { animation: drift .5s ease .1s both; }\n.s2 { animation: drift .5s ease .35s both; }\n.s3 { animation: drift .5s ease .6s both; }\n@keyframes donutGrow { 0% { stroke-dasharray: 0 251; } 100% { stroke-dasharray: 190 251; } }\n.donut-returns { stroke-dasharray: 190 251; animation: donutGrow 1.5s cubic-bezier(.22,1,.36,1) .4s both; }\n</style>\n\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:24px 20px; box-sizing:border-box;\">\n\n  <p class=\"s1\" style=\"font-size:16px; font-weight:700; margin:0; line-height:1.35;\" id=\"s13-title\">Let's project your wealth build from age 20 to 40.</p>\n\n  <div class=\"s1\" style=\"background:var(--bg-success, #EAF3DE); border:1px solid var(--text-success, #27500A); border-radius:100px; padding:4px 12px; display:inline-flex; align-items:center; gap:6px;\">\n    <span style=\"font-size:11px; font-weight:700; color:var(--text-success, #27500A);\" id=\"s13-assumption\">⚡ Assuming 12% Annual Compounding Return</span>\n  </div>\n\n  <!-- Meaningful Pie / Donut Chart -->\n  <div class=\"s2\" style=\"position:relative; width:150px; height:150px; margin:6px auto; display:flex; align-items:center; justify-content:center;\">\n    <svg width=\"150\" height=\"150\" viewBox=\"0 0 100 100\" style=\"transform: rotate(-90deg);\">\n      <!-- Total Invested Slice (Blue Arc) -->\n      <circle cx=\"50\" cy=\"50\" r=\"38\" fill=\"none\" stroke=\"#0C447C\" stroke-width=\"12\"/>\n      <!-- Earned Returns Slice (Green Arc) -->\n      <circle class=\"donut-returns\" cx=\"50\" cy=\"50\" r=\"38\" fill=\"none\" stroke=\"#27500A\" stroke-width=\"12\" stroke-dasharray=\"190 251\" stroke-linecap=\"round\"/>\n    </svg>\n    <!-- Center Stats -->\n    <div style=\"position:absolute; display:flex; flex-direction:column; align-items:center; justify-content:center;\">\n      <span style=\"font-size:9px; font-weight:700; color:var(--text-muted, #888780); text-transform:uppercase; letter-spacing:0.5px;\">GROWTH</span>\n      <span style=\"font-family:Georgia,serif; font-size:22px; font-weight:700; color:#27500A;\" id=\"s13-mult\">4.2x</span>\n      <span style=\"font-size:10px; font-weight:600; color:var(--text-secondary, #5F5E5A);\" id=\"s13-years\">20 Years</span>\n    </div>\n    <!-- Age Markers -->\n    <div style=\"position:absolute; bottom:-16px; left:8px; font-size:11px; color:var(--text-muted, #888780); font-weight:600;\" id=\"s13-start-age\">Age 20</div>\n    <div style=\"position:absolute; bottom:-16px; right:8px; font-size:11px; color:#0C447C; font-weight:700;\" id=\"s13-end-age\">Age 40</div>\n  </div>\n\n  <!-- Legend Breakdown Card -->\n  <div class=\"s3\" style=\"width:100%; max-width:280px; background:var(--surface-1, #F5F5F3); border-radius:14px; padding:12px 14px; border:1px solid var(--border, #E5E4DE); display:flex; flex-direction:column; gap:8px; margin-top:6px;\">\n    <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n      <div style=\"display:flex; align-items:center; gap:6px;\">\n        <div style=\"width:10px; height:10px; border-radius:50%; background:#0C447C;\"></div>\n        <span style=\"font-size:12px; color:var(--text-secondary, #5F5E5A); font-weight:500;\">Total Money Invested</span>\n      </div>\n      <span style=\"font-family:Georgia,serif; font-size:14px; font-weight:700; color:#171717;\" id=\"s13-invested\">₹12.0L</span>\n    </div>\n    <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n      <div style=\"display:flex; align-items:center; gap:6px;\">\n        <div style=\"width:10px; height:10px; border-radius:50%; background:#27500A;\"></div>\n        <span style=\"font-size:12px; color:#27500A; font-weight:600;\">Earned Returns (Profit)</span>\n      </div>\n      <span style=\"font-family:Georgia,serif; font-size:14px; font-weight:700; color:#27500A;\" id=\"s13-returns\">+₹37.9L</span>\n    </div>\n    <div style=\"height:1px; background:var(--border, #E5E4DE); margin:2px 0;\"></div>\n    <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n      <span style=\"font-size:12px; font-weight:700; color:#171717;\">Total Wealth at Age <span id=\"s13-target-age-lbl\">40</span></span>\n      <span style=\"font-family:Georgia,serif; font-size:18px; font-weight:800; color:#0C447C;\" id=\"s13-total\">₹49.9L</span>\n    </div>\n  </div>\n\n</div>",
