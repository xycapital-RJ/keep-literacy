s=\"s2\" style=\"font-family: Georgia, serif; font-style: italic; font-size: 46px; color: #fff; margin: 0;\">Time.</p>\n  <div class=\"s3\" style=\"position:relative; width:60px; height:60px; margin:0 auto;\">\n    <svg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\">\n      <path d=\"M14 6 H46 L32 30 L46 54 H14 L28 30 Z\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\" opacity=\"0.8\"/>\n      <path class=\"chart-line\" d=\"M8 50 L20 44 L30 34 L42 22 L54 10\" stroke=\"#4F7CFF\" stroke-width=\"2.5\" fill=\"none\" stroke-dasharray=\"120\"/>\n    </svg>\n    <div class=\"sand\" style=\"width:3px; height:3px; border-radius:50%; background:#fff; left:29px;\"></div>\n</div>",
