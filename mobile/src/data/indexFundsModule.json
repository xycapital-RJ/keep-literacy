      "html": "<style>\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n.s1 { animation: drift .5s ease .1s both; }\n.s2 { animation: drift .5s ease .5s both; }\n.s3 { animation: drift .5s ease .95s both; }\n.s4 { animation: drift .5s ease 1.4s both; }\n\n@keyframes shake { 0%,100% { transform: rotate(0deg);} 25% { transform: rotate(-8deg);} 75% { transform: rotate(8deg);} }\n.dig { animation: shake 0.6s ease-in-out infinite; display:inline-block; }\n\n@keyframes drawLine { 0% { stroke-dashoffset: 200; } 100% { stroke-dashoffset: 0; } }\n.line-steady { stroke-dasharray:200; animation: drawLine 1.4s ease .3s both; }\n.line-chaos { stroke-dasharray:220; animation: drawLine 1.8s ease .5s both; }\n\n@keyframes gearOut { 0%,60% { opacity:1; transform:rotate(0deg);} 100% { opacity:0; transform:rotate(90deg);} }\n@keyframes gearIn { 0%,60% { opacity:0; transform:rotate(-90deg) scale(.6);} 100% { opacity:1; transform:rotate(0deg) scale(1);} }\n.gear-old { animation: gearOut 2.4s ease infinite; position:absolute; }\n.gear-new { animation: gearIn 2.4s ease infinite; position:absolute; }\n\n@keyframes sandFall { 0% { top:14px; opacity:1;} 100% { top:40px; opacity:0;} }\n.sand { animation: sandFall 1.1s linear infinite; position:absolute; }\n@keyframes chartRise { 0% { stroke-dashoffset:120;} 100% { stroke-dashoffset:0;} }\n.chart-line { stroke-dasharray:120; animation: chartRise 2s ease-in-out .3s both; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:24px 20px; box-sizing:border-box;\">\n<p class=\"s1\" style=\"font-family: Georgia, serif; font-size: 32px; font-weight: 700; line-height: 1.15; margin: 0;\">It cleans itself.</p>\n  <div class=\"s2\" style=\"position:relative; width:80px; height:80px; margin:6px auto;\">\n    <i class=\"ti ti-settings gear-old\" style=\"font-size:44px; color:var(--text-muted); top:18px; left:18px;\" aria-hidden=\"true\"></i>\n    <i class=\"ti ti-settings gear-new\" style=\"font-size:44px; color:var(--text-accent); top:18px; left:18px;\" aria-hidden=\"true\"></i>\n  </div>\n  <p class=\"s3\" style=\"font-size: 13px; color: var(--text-secondary); margin: 0; max-width: 220px; margin-left:auto; margin-right:auto; line-height: 1.55;\">The NIFTY 50 is a self-cleaning index. If a company falls out of the top 50, it's automatically replaced by the next winner. You never have to read an earnings report or click \"sell.\"</p>\n</div>\n</div>",
