    {
      "slide_number": 13,
      "slide_id": "idx-s12-contribution",
      "description": "Screen 12 — Monthly Contribution Input",
      "html": "<style>\n@keyframes drift { 0% { opacity:0; transform:translateY(14px);} 100% { opacity:1; transform:translateY(0);} }\n.s1 { animation: drift .5s ease .1s both; }\n.s2 { animation: drift .5s ease 1.1s both; }\n.s3 { animation: drift .5s ease 1.4s both; }\n@keyframes dialTurn { 0% { stroke-dashoffset: 251; } 100% { stroke-dashoffset: 62; } }\n.dial-arc { stroke-dasharray:251; animation: dialTurn 1.4s cubic-bezier(.22,1,.36,1) .5s both; }\n@keyframes needleSettle { 0% { transform:rotate(-58deg);} 100% { transform:rotate(58deg);} }\n.needle { animation: needleSettle 1.4s cubic-bezier(.22,1,.36,1) .5s both; transform-origin: 50px 50px; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--surface-2, #FFFFFF); color: var(--text-primary, #171717); padding:24px 20px; box-sizing:border-box;\">\n<p class=\"s1\" style=\"font-size:16px; font-weight:500; margin:0; max-width:220px; margin-left:auto; margin-right:auto; line-height:1.5;\">Let's project this to age 40.</p>\n\n  <div style=\"position:relative; width:140px; height:140px; margin:0 auto;\">\n    <svg width=\"140\" height=\"140\" viewBox=\"0 0 100 100\">\n      <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"none\" stroke=\"var(--surface-1)\" stroke-width=\"8\"/>\n      <circle class=\"dial-arc\" cx=\"50\" cy=\"50\" r=\"40\" fill=\"none\" stroke=\"var(--text-accent)\" stroke-width=\"8\" stroke-linecap=\"round\" transform=\"rotate(-90 50 50)\"/>\n    </svg>\n    <svg width=\"140\" height=\"140\" viewBox=\"0 0 100 100\" style=\"position:absolute; top:0; left:0;\">\n      <line class=\"needle\" x1=\"50\" y1=\"50\" x2=\"50\" y2=\"18\" stroke=\"var(--text-primary)\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n      <circle cx=\"50\" cy=\"50\" r=\"4\" fill=\"var(--text-primary)\"/>\n    </svg>\n    <div style=\"position:absolute; bottom:-4px; left:14px; font-size:11px; color:var(--text-muted);\">24</div>\n    <div style=\"position:absolute; bottom:-4px; right:10px; font-size:11px; color:var(--text-accent); font-weight:600;\">40</div>\n</div>",
