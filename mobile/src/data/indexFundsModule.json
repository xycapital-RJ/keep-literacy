px; background:#a83232; animation: strike .6s ease 1.9s both; }\n.quote { animation: revealQuote 1.1s ease 1.1s both; }\n.s1 { animation: drift .5s ease .1s both; }\n.s2 { animation: drift .5s ease .55s both; }\n.s3 { animation: drift .5s ease 1.0s both; }\n</style>\n<div style=\"width:100%; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; text-align:center; background:var(--fill-primary, #171717); color: #FFFFFF; padding:24px 20px; box-sizing:border-box;\">\n<p class=\"s1\" style=\"font-size:13.5px; color:#fff; opacity:0.75; margin:0 auto; max-width:220px; line-height:1.5;\">In game theory, when a game is mathematically stacked against you, there's one winning move:</p>\n  <div style=\"position:relative; width:100px; height:100px; display:flex; align-items:center; justify-content:center; margin:0 auto;\">\n    <div class=\"board\" style=\"display:grid; grid-template-columns:repeat(4,1fr); width:86px; height:86px; border-radius:6px; overflow:hidden; border:2px solid #fff;\">\n      <div style=\"background:rgba(255,255,255,0.06);\"></div><div style=\"background:rgba(255,255,255,0.14);\"></div><div style=\"background:rgba(255,255,255,0.06);\"></div><div style=\"background:rgba(255,255,255,0.14);\"></div>\n      <div style=\"background:rgba(255,255,255,0.14);\"></div><div style=\"background:rgba(255,255,255,0.06);\"></div><div style=\"background:rgba(255,255,255,0.14);\"></div><div style=\"background:rgba(255,255,255,0.06);\"></div>\n      <div style=\"background:rgba(255,255,255,0.06);\"></div><div style=\"background:rgba(255,255,255,0.14);\"></div><div style=\"background:rgba(255,255,255,0.06);\"></div><div style=\"background:rgba(255,255,255,0.14);\"></div>\n      <div style=\"background:rgba(255,255,255,0.14);\"></div><div style=\"background:rgba(255,255,255,0.06);\"></div><div style=\"background:rgba(255,255,255,0.14);\"></div><div style=\"background:rgba(255,255,255,0.06);\"></div>\n</div>",
